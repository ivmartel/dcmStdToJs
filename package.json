{
  "name": "dcmstdtojs",
  "version": "0.3.0-beta.1",
  "description": "DICOM standard to js/json converter.",
  "keywords": [
    "DICOM"
  ],
  "license": "GPL-3.0",
  "author": "ivmartel <ivmartel@gmail.com>",
  "homepage": "https://ivmartel.github.io/dcmStdToJs/",
  "repository": {
    "type": "git",
    "url": "git://github.com/ivmartel/dcmStdToJs.git"
  },
  "type": "module",
  "main": "dist/dcmstdtojs.min.js",
  "types": "dist/dcmstdtojs.d.ts",
  "exports": {
    ".": {
      "types": "./dist/dcmstdtojs.d.ts",
      "default": "./dist/dcmstdtojs.min.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18"
  },
  "browserslist": "> 0.25%, not dead",
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@babel/preset-env": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.60.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@vitest/coverage-v8": "^5.0.5",
    "babel-loader": "^10.1.1",
    "babel-plugin-istanbul": "^8.0.2",
    "clean-jsdoc-theme": "5.2.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "eslint": "^10.13.0",
    "eslint-plugin-jsdoc": "~65.4.2",
    "globals": "^17.13.0",
    "html-webpack-plugin": "^5.6.8",
    "jsdoc": "^4.0.5",
    "jsdom": "^30.1.3",
    "style-loader": "^4.0.0",
    "typescript": "7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.1.0",
    "webpack-merge": "^6.0.1"
  },
  "scripts": {
    "prepack": "yarn run build",
    "start": "webpack serve --config config/webpack.dev.js",
    "pack": "webpack --config config/webpack.prod.js",
    "build": "yarn run pack && yarn run types && yarn run api",
    "build-demo": "webpack --config config/webpack.demo.js",
    "lint": "eslint -c config/eslint.config-full.js 'src/**/*.js' 'tests/**/*.js' '*.js'",
    "test": "vitest",
    "test-ci": "vitest --coverage",
    "doc": "jsdoc -c resources/doc/jsdoc.conf.json",
    "types": "tsc -p resources/api/tsconfig.json",
    "api": "api-extractor run -c resources/api/api-extractor.json --local"
  },
  "packageManager": "yarn@4.18.0"
}
