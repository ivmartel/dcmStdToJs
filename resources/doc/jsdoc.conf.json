{
  "plugins": ["node_modules/jsdoc/plugins/markdown"],
  "markdown": {
    "idInHeadings": true
  },
  "source": {
    "include": [
      "src",
      "tests"
    ]
  },
  "opts": {
    "strict": true,
    "recurse": true,
    "readme": "readme.md",
    "destination": "build/doc",
    "template": "node_modules/clean-jsdoc-theme/dist",
    "package": "package.json",
    "sectionOrder": [
      "Classes"
    ],
    "menu": [
      {
        "id": "home"
      },
      {
        "title": "github",
        "link": "https://github.com/ivmartel/dcmStdToJs",
        "icon": "simpleicons:github"
      },
      {
        "title": "npm",
        "link": "https://www.npmjs.com/package/dcmstdtojs",
        "icon": "simpleicons:npm"
      }
    ]
  }
}
